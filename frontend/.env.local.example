# Frontend local env — copy this file to .env.local and fill in values.
#   cp .env.local.example .env.local
# .env.local is gitignored; this example is committed as documentation.

# Local dev override — route API calls through the Vite proxy (same-origin),
# avoiding cross-origin CORS failures against the backend/agent.
# Leave EMPTY in dev => relative paths like /marketplace/services and /events.
VITE_BACKEND_URL=
VITE_AGENT_URL=

# WalletConnect (Reown) project id for the HashPack "fund agent" flow.
# Get a free id at https://cloud.reown.com and paste it here.
VITE_WALLETCONNECT_PROJECT_ID=your_reown_project_id

# World ID — public app id + action (should match backend WORLD_APP_ID/WORLD_ACTION).
# Note: the current frontend does not read these — the backend serves the signed
# World config via /world/rp-signature. Kept here for parity/documentation.
VITE_WORLD_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_WORLD_ACTION=publish-service
