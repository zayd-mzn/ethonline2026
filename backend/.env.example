# ============================================================================
# Backend environment — copy this file to .env and fill in values.
#   cp .env.example .env
# .env is gitignored; never commit real keys. All values here are placeholders.
#
# The backend runs fine with NONE of these set (Tier A / no-funds demo):
#   - payments fall back to a 402 flow the stub agent can drive
#   - HCS audit logging is disabled (non-fatal)
#   - World verification returns 503 until configured
# Fill in the sections below to enable real payments / real World identity.
# ============================================================================

# ---------------------------------------------------------------------------
# Server (optional)
# ---------------------------------------------------------------------------
# PORT=3001
# HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Threat-intel API keys (optional)
# If unset, the backend returns deterministic MOCK data — fine for demos.
# ---------------------------------------------------------------------------
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# ---------------------------------------------------------------------------
# Hedera — payments (x402) + HCS audit log   [required for real on-chain mode]
# ---------------------------------------------------------------------------
# Treasury / operator account (RECEIVES payments, creates the HCS topic).
HEDERA_ACCOUNT_ID=0.0.xxxxx
# IMPORTANT: use an ECDSA key in HEX form (0x + 64 hex). The payment client uses
# fromStringECDSA — an ED25519 (302e...) key will NOT work for real payments.
HEDERA_PRIVATE_KEY=0x...
# Account that receives HBAR. MUST differ from the agent's payer account,
# or Blocky402 rejects the transfer (invalid_exact_hedera_payload_amount_mismatch).
HEDERA_RECIPIENT=0.0.xxxxx
HEDERA_NETWORK=testnet

# Blocky402 facilitator URL (x402 v2 settlement). No API key needed on testnet.
BLOCKY402_URL=https://api.testnet.blocky402.com

# The agent's OWN Hedera account (the account it pays FROM). Exposed via
# GET /agent-info so the frontend HashPack "fund the agent" flow knows where to
# send the one-time top-up. Matches HEDERA_ACCOUNT_ID in agent/.env.
AGENT_ACCOUNT_ID=0.0.xxxxx

# ---------------------------------------------------------------------------
# World ID 4.0 — provider Selfie Check   [required for real identity]
# Developer Portal: https://developer.world.org  (see DEMO_SETUP.md §6)
# ---------------------------------------------------------------------------
# Your app id (public).
WORLD_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The action id; must exist in the environment you target (create in staging
# via the Developer Portal MCP, in production via the dashboard).
WORLD_ACTION=publish-service
# Relying party id from World ID Configuration > Register relying party.
WORLD_RP_ID=rp_xxxxxxxxxxxxxxxx
# staging  -> test with https://simulator.worldcoin.org (no phone needed)
# production -> real World App on a phone
WORLD_ENVIRONMENT=staging
# RP signing key — SECRET (0x + 64 hex), shown once at RP registration.
# Never commit it, never expose as a VITE_* var. If lost, rotate the signer.
RP_SIGNING_KEY=0x...
# Optional. Team API key (Team settings > API Keys) used ONLY to create the
# staging action via the Developer Portal MCP. Not read at runtime — leave
# empty / delete once the staging action exists.
WORLD_PORTAL_API_KEY=

# ---------------------------------------------------------------------------
# Agent human-backing enforcement (optional)
# When "true", gated /api/* routes reject requests without a verified agent
# identity (X-Agent-Id header) with 403, BEFORE any payment is quoted.
# Leave "false" for local/demo runs (dev bypass) so the quick-start works.
# ---------------------------------------------------------------------------
REQUIRE_AGENT_BACKING=false
