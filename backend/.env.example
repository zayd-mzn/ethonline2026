# Optional API keys for real threat-intel data.
# If unset, the backend falls back to deterministic mock data.
# Copy this file to .env and fill in your keys (.env is gitignored).

ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# World ID app (https://developer.world.org > your app). Public id.
WORLD_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WORLD_ACTION=publish-service

# World ID 4.0 relying party (Developer Portal > World ID Configuration).
# Register the relying party once; the portal shows rp_id and, exactly once,
# the RP signing key. The action must exist in the environment you target:
#   staging    -> test with https://simulator.worldcoin.org (no phone needed)
#   production -> real World App on a phone
WORLD_RP_ID=rp_xxxxxxxxxxxxxxxx
WORLD_ENVIRONMENT=staging
# RP signing key — SECRET, never commit. 0x-prefixed 64-hex private key.
RP_SIGNING_KEY=0x...
# Optional. Team API key (Team settings > API Keys) used only to create the
# staging action through the Developer Portal MCP (see WORLD_ID_STAGING_SETUP.md).
# Not read by the app at runtime; leave empty or delete once the action exists.
WORLD_PORTAL_API_KEY=

# Agent human-backing enforcement. When "true", gated /api/* routes reject
# requests without a verified agent identity (X-Agent-Id header) with 403,
# BEFORE any payment is quoted. Leave unset/"false" for local/demo runs
# (dev bypass) so the no-funds quick-start works without an agent identity.
REQUIRE_AGENT_BACKING=false

# Blocky402 facilitator URL (x402 v2 settlement). No API key needed for testnet.
BLOCKY402_URL=https://api.testnet.blocky402.com

# Hedera treasury account (receives HBAR payments)
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=302e...
HEDERA_RECIPIENT=0.0.xxxxx
HEDERA_NETWORK=testnet

# The agent's own Hedera account (the account it pays FROM). Exposed via
# GET /agent-info so the frontend HashPack "fund the agent" flow knows where
# to send the one-time top-up. This is the agent's HEDERA_ACCOUNT_ID from
# agent/.env — the account the human funds once, then the agent spends from
# autonomously.
AGENT_ACCOUNT_ID=0.0.xxxxx
