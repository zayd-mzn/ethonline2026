{
  "name": "@cyber-intel/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API server for the Cyber Intel Marketplace: threat-intel endpoints, service registry, per-query metering, x402 payment gating.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:reset": "rm -f data/registry.db data/registry.db-wal data/registry.db-shm"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.81.0",
    "fastify": "^5.12.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
