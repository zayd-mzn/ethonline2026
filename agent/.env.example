# Cyber Intel Marketplace — Agent (Member 3) environment
# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# Hedera testnet account the agent pays from.
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=302e0201...

# Which Hedera network to use.
HEDERA_NETWORK=testnet

# Base URL of the marketplace backend (Member 2).
BACKEND_URL=http://localhost:3001

# Spend cap (in HBAR) across a single agent run. The budget guard refuses
# any query that would push cumulative spend over this cap.
MAX_SPEND_HBAR=1.0

# Port for the activity event stream the frontend monitor connects to.
# Serves SSE at /events and a JSON snapshot at /activity.
EVENT_STREAM_PORT=3002

# Blocky402 facilitator URL (x402 v2 settlement). No API key needed for testnet.
BLOCKY402_URL=https://api.testnet.blocky402.com

# Payment mode: "stub" (default) settles nothing — safe for local dev/demo
# without funds. "real" settles on-chain via Blocky402 (needs a funded account
# and a valid ECDSA/DER key above).
PAYMENT_MODE=stub

# World Selfie Check proof for the agent's HUMAN OWNER (JSON string).
# This is the accountability link: the human verifies with World, and the
# backend ties the resulting agentId to that human. When set, the agent
# registers with the backend (POST /agents/register) on startup and receives
# a human-backed agentId that gated routes will accept.
# For local dev against the stub identity, use: WORLD_PROOF=dev-selfie-proof
# Leave unset to run unbacked (rejected by gated routes when the backend has
# REQUIRE_AGENT_BACKING=true).
WORLD_PROOF=
